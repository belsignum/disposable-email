				<target>Wegwerf-Anbieter</target>
			</trans-unit>
			<trans-unit id="providerType.freemail" resname="providerType.freemail">
				<source>Free email providers</source>
				<target>Freemail-Anbieter</target>
			</trans-unit>
			<trans-unit id="providerType.custom" resname="providerType.custom">
				<source>Custom lists</source>
				<target>Eigene Listen</target>
			</trans-unit>
			<trans-unit id="rules.allow.title" resname="rules.allow.title">
				<source>Whitelist</source>
				<target>Whitelist</target>
			</trans-unit>
			<trans-unit id="rules.allow.description" resname="rules.allow.description">
				<source>Always accepted, even if a provider list contains the domain.</source>
				<target>Immer zugelassen, auch wenn eine Anbieterliste die Domain enthält.</target>
			</trans-unit>
			<trans-unit id="rules.deny.title" resname="rules.deny.title">
				<source>Blacklist</source>
				<target>Blacklist</target>
			</trans-unit>
			<trans-unit id="rules.deny.description" resname="rules.deny.description">
				<source>Always rejected, even if no provider list contains the domain.</source>
				<target>Immer abgelehnt, auch wenn keine Anbieterliste die Domain enthält.</target>
			</trans-unit>
			<trans-unit id="rules.new" resname="rules.new">
