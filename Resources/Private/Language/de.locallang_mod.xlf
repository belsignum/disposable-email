				<target>Deaktivieren</target>
			</trans-unit>
			<trans-unit id="rules.delete.confirm" resname="rules.delete.confirm">
				<source>Delete the rule for %s?</source>
				<target>Regel für %s löschen?</target>
			</trans-unit>
